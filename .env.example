# Dedicated Bjorken database on your Atlas cluster. NEVER use Cotta's database.
# MONGO_URI is also supported. Use one URI variable, not both.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/bjorken_dev
MONGO_DB_NAME=bjorken_dev
BJORKEN_ADMIN_USERNAME=owner
# Generate a unique password of at least 16 characters.
BJORKEN_ADMIN_PASSWORD=
# Required in addition to owner approvals in admin to accept real requests.
BJORKEN_ENABLE_LIVE=false

# Cloudinary: preset must allow unsigned image uploads with this two-variable setup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Public production URL for absolute Open Graph / WhatsApp image URLs.
NEXT_PUBLIC_SITE_URL=https://bjorken-bakery.vercel.app
